# Email Configuration for Contact Form
# To enable email sending functionality:
# 1. Create a .env file in the root directory
# 2. Copy these variables and add your Gmail credentials
# 3. Enable 2-factor authentication on your Gmail account
# 4. Generate an App Password: https://support.google.com/accounts/answer/185833
# 5. Use the App Password (not your regular Gmail password)

GMAIL_USER=malekfazilkhan07@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password-here

# Example:
# GMAIL_USER=malekfazilkhan07@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Other environment variables
PING_MESSAGE=ping
